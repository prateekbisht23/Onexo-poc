# Copy to server/.env (Bun auto-loads it). Never commit the real file.

# OneXO sandbox-harness client — `bun scripts/seed-sandbox-harness-client.ts` in onexo_v1 prints both.
SANDBOX_HARNESS_CLIENT_ID=onexo-sandbox-harness-7c31e5
SANDBOX_HARNESS_CLIENT_SECRET=

# Where this server mints gateway tokens (OneXO Kong).
ONEXO_AUTH_URL=http://127.0.0.1:8000
# As seen by claude INSIDE the VM (reverse tunnels; same host IP, two ports):
#   gateway root  (-R 0.0.0.0:18000:localhost:8000), e.g. http://192.168.0.1:18000/llm
#   this server   (-R 0.0.0.0:18091:localhost:8091), e.g. http://192.168.0.1:18091 — the token helper's endpoint
ONEXO_LLM_URL=
POC_URL_FROM_VM=
# Gateway root as seen by the docker/local backend (default: host.docker.internal / 127.0.0.1 :8000/llm)
# ONEXO_LLM_URL_LOCAL=

# POC user → OneXO user/tenant public ids (spend is metered to this user).
ONEXO_ACT_USER_ID=
ONEXO_ACT_TENANT_ID=
# Per-user override: ONEXO_IDENTITY_MAP={"alice":{"userId":"…","tenantId":"…"}}

# How often claude's token helper fetches a fresh token (must stay below the 900s token TTL).
# GATEWAY_TOKEN_REFRESH_S=600

# Optional. Unset = the gateway decides which model serves each call.
# GATEWAY_MODEL=
# GATEWAY_SMALL_MODEL=
