# Copy to server/.env and fill in. Bun loads it automatically; chmod 600 it.
# Every value below is shared across the team EXCEPT CONNECTORS_USER_ID — see the note there.
# Leave a block empty to turn that feature off: the backend logs which variable is missing
# and falls back to its previous behaviour rather than failing to start.

# Plugs (README "Plugs"): where the agent runs and which CLI runs the loop. The gateway is
# chosen per user by `/login`: OneXO (AI gateway) or their own Anthropic account.
# SANDBOX=cubesandbox   # cubesandbox | docker | local
# HARNESS=claude-cli


# --- OneXO MCP servers (connectors + registry) -------------------------------
# Without these, a server's stored Authorization header is used as-is — and OneXO tokens
# live 1800s with no refresh, so it goes stale within the hour and every session needs a
# manual re-mint. With them set, a fresh token is minted at the start of each session.
CONNECTORS_TOKEN_URL=https://onexo-stg.fyscal.ai/public/auth/token
CONNECTORS_CLIENT_ID=onexo-run-agent-ef9684
CONNECTORS_CLIENT_SECRET=
CONNECTORS_TENANT_ID=

# YOUR OWN oauth_user.public_id — read `id` off GET /auth/me on the staging dashboard.
# This decides whose connectors resolve and who every execute_action audits to. Copying
# someone else's means acting as them, with nothing in the UI to indicate it.
CONNECTORS_USER_ID=

# The registry server needs its own client: the connectors one holds conn:i but not reg:r.
# Its client needs mcp:r + reg:r + conn:i — conn:i because it is one of only two scopes that
# unlock the run_tenant_public_id claim, without which the server registers ZERO tools.
REGISTRY_CLIENT_ID=
REGISTRY_CLIENT_SECRET=

# --- Guardrails ---------------------------------------------------------------
# Screens every prompt, tool call and tool result through OneXO's decide route. The VM holds
# only a short-lived gr:x token; rules and the classifier stay server-side. All five are
# required — with any of them missing the VM starts unscreened and says so in the log.
GUARDRAIL_DECIDE_URL=https://onexo-stg.fyscal.ai/agent/guardrails/decide
GUARDRAIL_TOKEN_URL=https://onexo-stg.fyscal.ai/public/auth/token
GUARDRAIL_CLIENT_ID=
GUARDRAIL_CLIENT_SECRET=
GUARDRAIL_TENANT_ID=

# --- AI gateway (OneXO login) -----------------------------------------------
# "Login with OneXO" client — `bun scripts/seed-poc-login-client.ts` in onexo_v1 prints both.
POC_LOGIN_CLIENT_ID=onexo-poc-login-3b9d41
POC_LOGIN_CLIENT_SECRET=
# OneXO Kong, as reached from this server AND the user's browser (same laptop in the POC).
ONEXO_AUTH_URL=http://127.0.0.1:8000
# Must equal the redirect URI registered by the seed script (default below).
# POC_LOGIN_REDIRECT_URI=http://localhost:8091/auth/onexo/callback

# As seen by claude INSIDE the VM (reverse tunnels; same host IP, two ports):
#   gateway root  (-R 0.0.0.0:18000:localhost:8000), e.g. http://192.168.0.1:18000/llm
#   this server   (-R 0.0.0.0:18091:localhost:8091), e.g. http://192.168.0.1:18091 — the token helper's endpoint
ONEXO_LLM_URL=
POC_URL_FROM_VM=
# Gateway root for SANDBOX=docker / local (defaults: host.docker.internal / 127.0.0.1 :8000/llm)
# ONEXO_LLM_URL_CONTAINER=
# ONEXO_LLM_URL_HOST=

# How often claude's token helper fetches a fresh OneXO token (must stay below the 900s token TTL).
# GATEWAY_TOKEN_REFRESH_S=600

# OneXO login only — optional model pin. Unset = Connectra's routing decides; set = pinned and
# the fallback chain is switched off (X-Onexo-Fallbacks: off).
# CONNECTRA_MODEL=
# CONNECTRA_SMALL_MODEL=
